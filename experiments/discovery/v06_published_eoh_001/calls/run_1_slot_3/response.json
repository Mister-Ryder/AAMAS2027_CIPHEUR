      "expression": {"op":"greedy_independent_weight","args":[{"op":"difference","args":[{"op":"difference","args":[{"op":"available","args":[]},{"op":"intersection","args":[{"op":"available","args":[]},{"op":"neighbors","args":[{"op":"root","args":[]}]}]}]},{"op":"singleton","args":[{"op":"root","args":[]}]}]}]}
    },
    {
      "name": "residual_cover",
      "expression": {"op":"clique_cover_weight","args":[{"op":"difference","args":[{"op":"difference","args":[{"op":"available","args":[]},{"op":"intersection","args":[{"op":"available","args":[]},{"op":"neighbors","args":[{"op":"root","args":[]}]}]}]},{"op":"singleton","args":[{"op":"root","args":[]}]}]}]}
    },
    {
      "name": "neighbor_pack",
      "expression": {"op":"greedy_independent_weight","args":[{"op":"intersection","args":[{"op":"available","args":[]},{"op":"neighbors","args":[{"op":"root","args":[]}]}]}]}
    },
    {
      "name": "neighbor_cover",
      "expression": {"op":"clique_cover_weight","args":[{"op":"intersection","args":[{"op":"available","args":[]},{"op":"neighbors","args":[{"op":"root","args":[]}]}]}]}
    },
    {
      "name": "boundary_edges",
      "expression": {"op":"sub","args":[{"op":"sub","args":[{"op":"count","args":[{"op":"induced_edges","args":[{"op":"difference","args":[{"op":"available","args":[]},{"op":"singleton","args":[{"op":"root","args":[]}]}]}]}]},{"op":"count","args":[{"op":"induced_edges","args":[{"op":"intersection","args":[{"op":"available","args":[]},{"op":"neighbors","args":[{"op":"root","args":[]}]}]}]}]}]},{"op":"count","args":[{"op":"induced_edges","args":[{"op":"difference","args":[{"op":"difference","args":[{"op":"available","args":[]},{"op":"intersection","args":[{"op":"available","args":[]},{"op":"neighbors","args":[{"op":"root","args":[]}]}]}]},{"op":"singleton","args":[{"op":"root","args":[]}]}]}]}]}]}
