        {
          "name": "neighbor_cover",
          "expression": {"op": "clique_cover_weight", "args": [{"op": "neighbors", "args": [{"op": "root", "args": []}]}]}
        }
      ],
      "rule": "weight/max(1,neighbor_cover)",
