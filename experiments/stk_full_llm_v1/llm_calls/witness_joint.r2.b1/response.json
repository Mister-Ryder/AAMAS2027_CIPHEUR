      "name": "mean_conflict_density",
      "rationale": "Adjusts reward per blocked contact by a bounded comparison with mean conflicting reward, keeping count and weight scales separate. Uses only base inputs and remains blind to remote edge rearrangements.",
      "rule": "weight / (1 + degree) * (1 + 0.15 * (weight - conflict_weight / max(1, degree)) / (1 + weight + conflict_weight / max(1, degree)))"
