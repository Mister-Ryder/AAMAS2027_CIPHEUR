      "name": "degree_first_bounded_reward",
      "rationale": "Keeps degree ordering primary, using bounded reward and conflict terms within each degree class. Requires no added graph computation, but cannot represent the certified nonlocal reversal.",
      "rule": "-degree + 0.4 * weight / (1 + weight + max_conflict_weight) - 0.1 * conflict_weight / ((1 + degree) * (1 + weight + conflict_weight))"
