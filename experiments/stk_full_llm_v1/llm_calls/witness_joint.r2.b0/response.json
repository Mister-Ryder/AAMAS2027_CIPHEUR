      "features": [],
      "name": "sparsity_with_bounded_rival_margin",
      "rationale": "Combines reward per blocked contact with a bounded strongest-rival correction. Immediate aggregates require no added graph work and cannot distinguish the remote witness.",
      "rule": "weight / (1 + degree) * (1 + 0.12 * (weight - max_conflict_weight) / (1 + weight + max_conflict_weight))"
    },
    {
      "features": [],
      "name": "small_residual_margin_and_mild_gap_cost",
      "rationale": "Uses relative rival regret in residuals containing at most two contacts, then weighted sparsity with a mild normalized gap discount. Base9 computation is inexpensive but remains pointwise.",
      "rule": "(weight - max_conflict_weight) / (1 + weight + max_conflict_weight) if remaining_count <= 2 else weight / (1 + degree) * (1 - 0.08 * (station_gap + satellite_gap) / (1 + duration + station_gap + satellite_gap))"
    },
    {
      "features": [],
      "name": "count_priority_with_mean_conflict_regret",
      "rationale": "Prioritizes fewer blocked contacts and resolves equal counts using bounded reward versus mean-conflict regret. Count and reward scales remain separate; there is no added graph computation or remote structural information.",
      "rule": "-degree + 0.5 * (weight - conflict_weight / (1 + degree)) / (1 + weight + conflict_weight / (1 + degree))"
    },
