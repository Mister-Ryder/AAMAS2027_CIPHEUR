      "name": "cheap_density_blend",
      "rationale": "Blends reward per conflict with a small heaviest-conflict margin. Uses only base9 inputs with no added graph computation; its pointwise information cannot resolve the witnessed reversal.",
      "rule": "weight / (1 + 0.25 * max(0, degree)) + 0.1 * (weight - max_conflict_weight) / (1 + max(0, degree))"
    },
    {
      "features": [],
      "name": "cheap_pressure_gate",
      "rationale": "A generic comparison with the heaviest conflict switches between net reward and penalized density. This inexpensive conditional candidate uses immediate aggregates and retains the nonlocal representation limitation.",
      "rule": "(weight - 0.35 * max_conflict_weight - 0.1 * conflict_weight / (1 + max(0, degree))) if weight >= max_conflict_weight else (weight / (1 + 0.15 * max(0, degree)) - 0.45 * (max_conflict_weight - weight))"
    },
