{
  "schema_version": "stk_online_llm_v2",
  "recipes": [
    {
      "name": "cheap_second_ring",
      "features": [
        {
          "name": "second_ring_count",
          "expression": {
            "op": "count",
            "args": [
              {
                "op": "difference",
                "args": [
                  {
                    "op": "neighbors_of_set",
                    "args": [
                      {
                        "op": "neighbors",
                        "args": [
                          {
                            "op": "root",
                            "args": []
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "union",
                    "args": [
                      {
                        "op": "singleton",
                        "args": [
                          {
                            "op": "root",
                            "args": []
                          }
                        ]
                      },
                      {
                        "op": "neighbors",
                        "args": [
                          {
                            "op": "root",
                            "args": []
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "rule": "c0 * weight / max(1, 1 + degree + c1 * second_ring_count) - (c2 * neighbor_max_weight + c3 * neighbor_weight_sum)",
      "patch_policy": {
        "anchor": "uniform",
        "destroy_count": 1,
        "patch_cap": 16,
        "expand_hops": 1,
        "reconstruction": "greedy"
      },
      "evaluation_plan": {
        "feature_scope": "patch",
        "max_feature_cpu_fraction": 0.08,
        "lazy": true
      },
      "adaptation_template": {
        "mutation_scales": [
          0.05,
          0.12,
          0.3,
          0.6
        ],
        "stagnation_trials": 12,
        "action": "mutate"
      },
      "coefficients": [
        1.0,
        0.12,
        0.08,
        0.02
      ],
      "rationale": "The certified TRAIN preference cycles expose a conflict in a common base9 pointwise representation; they do not establish that this feature resolves it. Exact second-ring cardinality supplies a cheap structural operand on at most 16 nodes, responding to the reference's roughly 9.2 seconds of feature CPU in a 10-second solve. Live mutations are judged by feasible integer reward improvement and charged CPU within each reset instance."
    },
    {
      "name": "blocked_clique_crowding",
