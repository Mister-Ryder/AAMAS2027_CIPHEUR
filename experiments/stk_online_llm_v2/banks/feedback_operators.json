                        "args": [
                          {
                            "op": "neighbors",
                            "args": [
                              {
                                "op": "root",
                                "args": []
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "op": "count",
                        "args": [
                          {
                            "op": "neighbors",
                            "args": [
                              {
                                "op": "root",
                                "args": []
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "rule": "(c0 * weight - c1 * neighbor_cover) + (c2 * weight * neighbor_density - c3 * neighbor_max_weight)",
      "patch_policy": {
        "anchor": "blocked_gain",
        "destroy_count": 3,
        "patch_cap": 24,
        "expand_hops": 1,
        "reconstruction": "greedy"
      },
      "evaluation_plan": {
        "feature_scope": "patch",
        "max_feature_cpu_fraction": 0.16,
        "lazy": true
      },
      "adaptation_template": {
        "mutation_scales": [
          0.04,
          0.12,
          0.3,
          0.6
        ],
        "stagnation_trials": 15,
        "action": "mutate"
      },
      "coefficients": [
        1.0,
        0.7,
        0.3,
        0.025
      ],
      "rationale": "Neighbor adjacency distinguishes mutually conflicting alternatives from independent alternatives that base degree and total weight merge. Cover cost and normalized edge density enter ranking directly, while blocked-gain anchoring targets incumbent blockers. The witness condition uses exact bounded adjacency; the feedback-only control receives no structural witness. Neither these summaries nor archive consistency certify schedule improvement."
    },
    {
      "name": "rejected_neighbor_packing",
      "features": [
        {
          "name": "neighbor_pack",
          "expression": {
            "op": "greedy_independent_weight",
            "args": [
              {
                "op": "neighbors",
                "args": [
                  {
                    "op": "root",
                    "args": []
                  }
                ]
              }
            ]
