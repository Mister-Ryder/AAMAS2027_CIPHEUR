            "args": [
              {
                "op": "neighbors",
                "args": [
                  {
                    "op": "root",
                    "args": []
                  }
                ]
              }
            ]
          }
        }
      ],
      "rule": "(c0 * weight - c1 * neighbor_pack) - (c2 * max(0, neighbor_cover - neighbor_pack) + c3 * neighbor_max_weight)",
      "patch_policy": {
        "anchor": "rejection_frontier",
        "destroy_count": 4,
        "patch_cap": 24,
        "expand_hops": 1,
        "reconstruction": "rcl"
