      "rule": "c0 * weight / max(1, 1 + degree) + c1 * weight * frontier_count / max(1, remaining_count) / max(1, 1 + degree) - c2 * max_conflict_weight / max(1, 1 + degree) + c3 * weight / max(1, remaining_count)",
      "patch_policy": {
